# Server-only; set DATABASE_URL in Vercel's sensitive production environment.
# For local development, copy this to ignored .env.local and supply your own Neon pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
EDGEBOARD_SESSION_SECRET=replace-with-a-long-random-secret
EDGEBOARD_ADMIN_PASSWORD=replace-with-a-strong-password
